# LaunchBase Environment Variables
# Copy this file to .env and fill in your actual values

# Coolify
COOLIFY_BASE_URL=https://coolify.yourdomain.com
COOLIFY_API_TOKEN=your_coolify_api_token_here

# Cloudflare
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Unraid (SSH access)
UNRAID_HOST=your_unraid_ip
UNRAID_PORT=22
UNRAID_USER=root
UNRAID_PASSWORD=your_unraid_password

# Sync
SYNC_SECRET=your_secure_random_string_here